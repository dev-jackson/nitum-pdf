import { ScrollView } from "std-widgets.slint";
import { Theme, Space, Radius, Type, Motion } from "theme.slint";

// Shared primitives. A screen assembles these; it does not invent its own
// paddings, radii or focus treatments.

export enum ButtonTone { primary, secondary, ghost, danger }

export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <ButtonTone> tone: ButtonTone.secondary;
    in property <bool> enabled: true;
    in property <bool> wide: false;
    callback clicked;

    height: 36px;
    min-width: root.wide ? 0px : 96px;
    horizontal-stretch: root.wide ? 1 : 0;
    border-radius: Radius.md;
    opacity: root.enabled ? 1.0 : 0.4;

    property <bool> filled: root.tone == ButtonTone.primary || root.tone == ButtonTone.danger;
    property <color> base: root.tone == ButtonTone.primary ? Theme.accent
        : root.tone == ButtonTone.danger ? Theme.danger
        : root.tone == ButtonTone.ghost ? transparent
        : Theme.raised;
    property <color> hovered: root.tone == ButtonTone.primary ? Theme.accent-hover
        : root.tone == ButtonTone.danger ? Theme.danger
        : Theme.accent-soft;
    property <color> ink: root.filled ? Theme.text-on-accent : Theme.text;

    background: !root.enabled ? root.base : touch.pressed ? (root.tone == ButtonTone.primary ? Theme.accent-pressed : root.hovered)
        : touch.has-hover ? root.hovered : root.base;
    border-width: focus.has-focus ? 2px : root.filled ? 0px : 1px;
    border-color: focus.has-focus ? (root.filled ? Theme.text-on-accent : Theme.focus-ring)
        : root.tone == ButtonTone.ghost ? transparent : Theme.border;
    animate background { duration: Motion.instant; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: Space.md;
        padding-right: Space.md;
        spacing: Space.sm;
        alignment: center;
        if root.icon.width > 0: Rectangle {
            width: 16px;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.ink;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: Type.body;
            font-weight: root.filled ? Type.semibold : Type.medium;
            vertical-alignment: center;
        }
    }

    focus := FocusScope {
        x: 0; width: 0px;
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

export component IconAction inherits Rectangle {
    in property <image> icon;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked;

    width: 36px;
    height: 36px;
    border-radius: Radius.md;
    opacity: root.enabled ? 1.0 : 0.35;
    background: root.active ? Theme.accent-soft
        : touch.pressed ? Theme.border
        : touch.has-hover ? Theme.accent-soft
        : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus-ring;
    animate background { duration: Motion.instant; }

    accessible-role: button;
    accessible-label: root.hint;
    accessible-enabled: root.enabled;

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.active ? Theme.accent : Theme.text-secondary;
    }

    focus := FocusScope {
        x: 0; width: 0px;
        enabled: root.enabled;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

// A labelled field. The label sits above the control, always, so the eye scans
// one column instead of hunting for which label belongs to which input.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> help;
    spacing: Space.xs;
    Text {
        text: root.label;
        color: Theme.text-secondary;
        font-size: Type.small;
        font-weight: Type.medium;
    }
    @children
    if root.help != "": Text {
        text: root.help;
        color: Theme.text-tertiary;
        font-size: Type.caption;
        wrap: word-wrap;
    }
}

// Status that never depends on colour alone: icon, then word, then tint.
export enum StatusTone { neutral, positive, caution, negative }

export component StatusPill inherits Rectangle {
    in property <string> label;
    in property <StatusTone> tone: StatusTone.neutral;
    in property <image> icon;

    height: 24px;
    border-radius: Radius.pill;
    background: root.tone == StatusTone.positive ? Theme.success-soft
        : root.tone == StatusTone.caution ? Theme.warning-soft
        : root.tone == StatusTone.negative ? Theme.danger-soft
        : Theme.accent-soft;

    property <color> ink: root.tone == StatusTone.positive ? Theme.success
        : root.tone == StatusTone.caution ? Theme.warning
        : root.tone == StatusTone.negative ? Theme.danger
        : Theme.accent;

    accessible-role: text;
    accessible-label: root.label;

    HorizontalLayout {
        padding-left: Space.sm;
        padding-right: Space.sm;
        spacing: Space.xs;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 13px;
                height: 13px;
                colorize: root.ink;
            }
        }
        Text {
            text: root.label;
            color: root.ink;
            font-size: Type.caption;
            font-weight: Type.semibold;
            vertical-alignment: center;
        }
    }
}

// A row in a list of things to choose from. Hierarchy comes from weight and
// space; the only border is the hairline that separates one row from the next.
export component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <image> icon;
    in property <bool> is-selected: false;
    // An option row shows which one of the group is chosen; an action row shows
    // what happens when you pick it. Both keep the same left column so every
    // title in a dialog starts at the same x.
    in property <bool> option: false;
    in property <string> action;
    callback chosen;

    height: root.detail == "" ? 44px : 56px;
    border-radius: Radius.md;
    background: root.is-selected ? Theme.accent-soft
        : touch.has-hover ? Theme.accent-soft
        : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus-ring;
    // No `animate background` here: when the dialog subtree is rebuilt, an
    // animated background keeps painting the previous instance's colour, so the
    // highlight lands on the row that used to be selected.

    accessible-role: button;
    accessible-label: root.title + ". " + root.detail;
    accessible-checked: root.is-selected;

    HorizontalLayout {
        spacing: Space.md;

        if root.option: Rectangle {
            width: 24px;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: root.is-selected ? 0px : 1px;
                border-color: Theme.border-strong;
                background: root.is-selected ? Theme.accent : transparent;
                if root.is-selected: Image {
                    source: @image-url("../../data/icons/check.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-on-accent;
                }
            }
        }

        if !root.option && root.icon.width > 0: Rectangle {
            width: 24px;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: root.is-selected ? Theme.accent : Theme.text-secondary;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Type.body;
                font-weight: Type.semibold;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: Theme.text-secondary;
                font-size: Type.small;
                overflow: elide;
            }
        }

        if root.action != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.action;
                color: Theme.accent;
                font-size: Type.small;
                font-weight: Type.semibold;
            }
        }
    }

    focus := FocusScope {
        x: 0; width: 0px;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.chosen(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.chosen(); }
    }
}

export component Separator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A dialog sized by its own content, capped by the window. Fixed heights were
// the single biggest source of dead space and clipped controls.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <length> available-height: 640px;
    in property <bool> show-back: false;
    // At most one primary action per dialog, and it lives in the footer where
    // the eye lands after reading the content.
    in property <string> primary-label;
    in property <string> secondary-label;
    in property <bool> primary-enabled: true;
    in property <image> primary-icon;
    in property <ButtonTone> primary-tone: ButtonTone.primary;
    callback closed;
    callback back;
    callback primary-activated;
    callback secondary-activated;

    property <length> footer-height: root.primary-label == "" && !root.show-back ? 0px : 60px;

    border-radius: Radius.lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 32px;
    drop-shadow-color: Theme.shadow-floating;
    drop-shadow-offset-y: 12px;
    height: min(root.available-height, head.preferred-height + body.preferred-height + root.footer-height);

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        head := VerticalLayout {
            padding-left: Space.xl;
            padding-right: Space.md;
            padding-top: Space.lg;
            padding-bottom: Space.md;
            spacing: Space.xs;
            HorizontalLayout {
                spacing: Space.sm;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        color: Theme.text;
                        font-size: Type.title;
                        font-weight: Type.bold;
                    }
                }
                IconAction {
                    icon: @image-url("../../data/icons/close.svg");
                    hint: "Cerrar";
                    clicked => { root.closed(); }
                }
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.text-secondary;
                font-size: Type.body;
                wrap: word-wrap;
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: body.preferred-height;
            body := VerticalLayout {
                width: parent.width;
                padding-left: Space.xl;
                padding-right: Space.xl;
                padding-top: Space.lg;
                padding-bottom: Space.lg;
                spacing: Space.lg;
                @children
            }
        }

        if root.primary-label != "" || root.show-back: Rectangle {
            height: 60px;
            background: Theme.surface;
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: Space.xl;
                padding-right: Space.xl;
                padding-top: Space.md;
                padding-bottom: Space.md;
                spacing: Space.sm;
                if root.show-back: ActionButton {
                    label: "Atrás";
                    icon: @image-url("../../data/icons/chevron-left.svg");
                    tone: ButtonTone.secondary;
                    clicked => { root.back(); }
                }
                if root.secondary-label != "": ActionButton {
                    label: root.secondary-label;
                    tone: ButtonTone.secondary;
                    clicked => { root.secondary-activated(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.primary-label != "": ActionButton {
                    label: root.primary-label;
                    icon: root.primary-icon;
                    tone: root.primary-tone;
                    enabled: root.primary-enabled;
                    clicked => { root.primary-activated(); }
                }
            }
        }
    }
}

// The footer of a dialog: secondary on the left, the one primary on the right.
export component DialogFooter inherits Rectangle {
    height: 60px;
    background: Theme.surface;
    Rectangle { height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: Space.xl;
        padding-right: Space.xl;
        padding-top: Space.md;
        padding-bottom: Space.md;
        spacing: Space.sm;
        @children
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;
    in property <string> help;
    callback toggled;

    height: root.help == "" ? 24px : 40px;
    background: transparent;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;

    HorizontalLayout {
        spacing: Space.md;
        alignment: start;
        Rectangle {
            width: 24px;
            Rectangle {
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: Radius.sm;
                background: root.checked ? Theme.accent : transparent;
                border-width: focus.has-focus ? 2px : 1px;
                border-color: focus.has-focus ? Theme.focus-ring : root.checked ? Theme.accent : Theme.border-strong;
                if root.checked: Image {
                    source: @image-url("../../data/icons/check.svg");
                    width: 12px;
                    height: 12px;
                    colorize: Theme.text-on-accent;
                }
            }
        }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Type.body;
            }
            if root.help != "": Text {
                text: root.help;
                color: Theme.text-tertiary;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }
    }

    focus := FocusScope {
        x: 0; width: 0px;
        focus-on-tab-navigation: true;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.checked = !root.checked; root.toggled(); }
    }
}

// Progressive disclosure: the rare, expert controls stay out of the way until asked for.
export component Disclosure inherits VerticalLayout {
    in property <string> label;
    in-out property <bool> expanded: false;
    spacing: Space.sm;

    Rectangle {
        height: 28px;
        border-radius: Radius.sm;
        background: touch.has-hover ? Theme.accent-soft : transparent;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.focus-ring;
        accessible-role: button;
        accessible-label: root.label;
        accessible-expanded: root.expanded;
        HorizontalLayout {
            spacing: Space.xs;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../data/icons/chevron-right.svg");
                    width: 14px;
                    height: 14px;
                    colorize: Theme.accent;
                    transform-rotation: root.expanded ? 90deg : 0deg;
                }
            }
            Text {
                text: root.label;
                color: Theme.accent;
                font-size: Type.small;
                font-weight: Type.semibold;
                vertical-alignment: center;
            }
        }
        focus := FocusScope {
            x: 0; width: 0px;
            focus-on-tab-navigation: true;
            key-pressed(event) => {
                if (event.text == " " || event.text == "\n") { root.expanded = !root.expanded; return accept; }
                return reject;
            }
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { focus.focus(); root.expanded = !root.expanded; }
        }
    }

    // @children cannot sit inside a conditional, so the panel collapses by height.
    Rectangle {
        clip: true;
        height: root.expanded ? inner.preferred-height : 0px;
        animate height { duration: Motion.quick; }
        inner := VerticalLayout {
            width: parent.width;
            spacing: Space.md;
            padding-left: Space.lg;
            @children
        }
    }
}

// A consequence, stated before the person commits to it.
export component Note inherits Rectangle {
    in property <string> message;
    in property <StatusTone> tone: StatusTone.neutral;
    in property <image> icon;

    border-radius: Radius.md;
    height: layout.preferred-height;
    background: root.tone == StatusTone.positive ? Theme.success-soft
        : root.tone == StatusTone.caution ? Theme.warning-soft
        : root.tone == StatusTone.negative ? Theme.danger-soft
        : Theme.accent-soft;

    property <color> ink: root.tone == StatusTone.positive ? Theme.success
        : root.tone == StatusTone.caution ? Theme.warning
        : root.tone == StatusTone.negative ? Theme.danger
        : Theme.accent;

    accessible-role: text;
    accessible-label: message;

    layout := HorizontalLayout {
        padding: Space.md;
        spacing: Space.sm;
        alignment: start;
        if root.icon.width > 0: VerticalLayout {
            alignment: start;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.ink;
            }
        }
        Text {
            text: root.message;
            color: root.ink;
            font-size: Type.small;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}
