import { Palette as SystemPalette } from "std-widgets.slint";

// Design tokens. Every measurement in the interface resolves to one of these:
// a value that appears nowhere in this file does not belong in a component.

export global Space {
    // A 4-point rhythm, held tighter than the conventional 8-point one. Density
    // is a deliberate choice here: more of the document stays visible, and the
    // interface reads as purposeful rather than roomy.
    out property <length> xs: 4px;
    out property <length> sm: 6px;
    out property <length> md: 10px;
    out property <length> lg: 14px;
    out property <length> xl: 20px;
    out property <length> xxl: 28px;
    out property <length> section: 36px;
}

export global Radius {
    // Tighter than the soft, rounded default that every framework ships with.
    out property <length> sm: 4px;
    out property <length> md: 7px;
    out property <length> lg: 11px;
    out property <length> pill: 999px;
}

export global Type {
    // Sizes climb by a fourth; weights carry the hierarchy so boxes do not have to.
    // Geist has a smaller x-height than the system default, so each step is a
    // point larger than a system-font scale would need for the same weight on
    // the page.
    out property <length> caption: 11px;
    out property <length> small: 12px;
    out property <length> body: 14px;
    out property <length> emphasis: 15px;
    out property <length> title: 19px;
    out property <length> display: 26px;

    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}

export global Motion {
    out property <duration> instant: 90ms;
    out property <duration> quick: 140ms;
    out property <duration> calm: 220ms;
}

export global Theme {
    // Follows the system until the person explicitly chooses Claro or Oscuro.
    in-out property <bool> dark: SystemPalette.color-scheme == ColorScheme.dark;

    // Surfaces, from furthest back to closest to the eye.
    //
    // The neutrals carry a trace of the brand red rather than being pure grey.
    // It is far too little to name as a colour and exactly enough that the
    // interface stops reading as a default template.
    out property <color> canvas: dark ? #14100f : #f7f4f4;
    out property <color> surface: dark ? #1d1817 : #ffffff;
    out property <color> raised: dark ? #2a2321 : #fbf8f8;
    out property <color> sunken: dark ? #0d0a0a : #efe9e9;
    // A page of the document is white in both themes: it is the paper, not chrome.
    out property <color> page: #ffffff;

    // Text. `secondary` holds AA against surface; `tertiary` is for non-essential detail only.
    out property <color> text: dark ? #faf7f7 : #1a1414;
    out property <color> text-secondary: dark ? #c2b7b6 : #635b5b;
    out property <color> text-tertiary: dark ? #998e8d : #746b6b;
    // Ink on a filled accent surface. Dark mode uses a dark ink because a
    // light accent bright enough to read as an accent cannot carry white text.
    out property <color> text-on-accent: dark ? #0d1220 : #ffffff;

    // Lines. Hairlines separate; never draw a box where a hairline is enough.
    out property <color> border: dark ? #ffffff2e : #1a141429;
    out property <color> border-strong: dark ? #ffffff7a : #1a14148a;

    // The accent is the brand red. It used to be a generic blue, on the argument
    // that red should be reserved for danger — which left the product with a red
    // icon and an interface that could have belonged to any application.
    //
    // Danger is now told apart from the accent by depth rather than hue: a
    // destructive action is darker and heavier than an ordinary one, and it
    // always says what it destroys, so the two are never confused.
    out property <color> accent: dark ? #ff6b6b : #c2202c;
    out property <color> accent-hover: dark ? #ff8585 : #a8151f;
    out property <color> accent-pressed: dark ? #e85555 : #8a0f18;
    out property <color> accent-soft: dark ? #ff6b6b1f : #c2202c12;

    out property <color> success: dark ? #3ecf8e : #0a7a4c;
    out property <color> success-soft: dark ? #3ecf8e24 : #0a7a4c0f;
    out property <color> warning: dark ? #f0b429 : #8a5500;
    out property <color> warning-soft: dark ? #f0b42924 : #8a55000f;
    // Deeper than the accent, so destruction reads as heavier than action.
    out property <color> danger: dark ? #ff9a8b : #8a0f18;
    out property <color> danger-soft: dark ? #ff9a8b24 : #8a0f1814;

    out property <color> focus-ring: dark ? #ffb3ad : #8a0f18;
    out property <color> scrim: dark ? #000000a6 : #1a141473;

    // Depth. A primary action and a dialog are lit from above rather than being
    // flat fills, which is most of what separates a designed interface from a
    // set of coloured rectangles. The shift is a few percent — enough to catch
    // the eye, never enough to read as a gradient.
    out property <brush> accent-fill: dark
        ? @linear-gradient(180deg, #ff7d7d 0%, #f05a5a 100%)
        : @linear-gradient(180deg, #d02734 0%, #b01c27 100%);
    out property <brush> accent-fill-hover: dark
        ? @linear-gradient(180deg, #ff9494 0%, #ff6f6f 100%)
        : @linear-gradient(180deg, #b81a24 0%, #9c1219 100%);
    out property <brush> surface-fill: dark
        ? @linear-gradient(180deg, #221c1b 0%, #1a1615 100%)
        : @linear-gradient(180deg, #ffffff 0%, #fdfbfb 100%);
    out property <brush> raised-fill: dark
        ? @linear-gradient(180deg, #2f2725 0%, #262020 100%)
        : @linear-gradient(180deg, #fdfbfb 0%, #f6f1f1 100%);

    // Elevation. Shadows carry the layering, so no component invents its own.
    out property <color> shadow-raised: dark ? #00000073 : #1a141426;
    out property <color> shadow-floating: dark ? #0000008c : #1a14142e;
    out property <color> shadow-page: dark ? #00000080 : #1a141424;
}
