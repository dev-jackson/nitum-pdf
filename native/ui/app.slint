import { Button, LineEdit, ListView, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Palette as SystemPalette } from "std-widgets.slint";
import { Theme, Space, Radius, Type, Motion } from "theme.slint";
import { ActionButton, IconAction, Field, StatusPill, ChoiceRow, Separator, Dialog, Toggle, Disclosure, Note, ButtonTone, StatusTone } from "components.slint";

// Re-exported so tests and the Rust side can switch the theme.
export { Theme }

export struct VerificationCheck {
    // 0 neutral, 1 correct, 2 needs attention, 3 failed.
    tone: int,
    label: string,
    detail: string,
}

export struct PageItem {
    number: int,
    image: image,
    aspect: float,
    loaded: bool,
    error: string,
}


export component AppWindow inherits Window {
    title: document-open ? document-title + " — Nitum PDF" : "Nitum PDF";
    // Our own chrome. The system title bar wasted a whole row on a string the
    // toolbar already shows, and it never matched the application's own theme.
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1180px; preferred-height: 820px;
    min-width: 720px; min-height: 560px;
    background: Theme.canvas;
    property <bool> effective-dark-theme: Theme.dark;
    init => {
        SystemPalette.color-scheme = effective-dark-theme ? ColorScheme.dark : ColorScheme.light;
        root.compact-header = root.width < 900px;
    }
    changed effective-dark-theme => { SystemPalette.color-scheme = effective-dark-theme ? ColorScheme.dark : ColorScheme.light; }
    changed width => { root.compact-header = root.width < 900px; }

    in-out property <bool> document-open: false;
    in-out property <string> document-title: "Nitum PDF";
    in-out property <string> document-path: "";
    in-out property <int> current-page: 0;
    in-out property <int> page-count: 0;
    in-out property <int> zoom-percent: 100;
    in-out property <int> active-dialog: 0;
    in-out property <bool> document-loading: false;
    in-out property <string> document-error: "";
    in-out property <image> page-image;
    in-out property <float> page-aspect: 1.414;
    in-out property <bool> search-open: false;
    in-out property <string> search-status: "";
    in-out property <string> viewer-status: "";
    in-out property <string> identity-path: "";
    in-out property <string> identity-name: "";
    in-out property <[string]> identity-options: [];
    in-out property <bool> signing-busy: false;
    in-out property <bool> signing-success: false;
    in-out property <string> signing-status: "";
    in-out property <bool> unlock-busy: false;
    in-out property <string> unlock-status: "";
    in-out property <bool> update-available: false;
    in-out property <bool> update-checking: false;
    in-out property <string> current-version: "";
    in-out property <string> update-version: "";
    in-out property <bool> update-busy: false;
    in-out property <string> update-status: "";
    in-out property <bool> verification-busy: false;
    in-out property <bool> verification-success: false;
    in-out property <string> verification-status: "";
    in-out property <[VerificationCheck]> verification-checks: [];
    // The status line is a plain statement unless something actually went wrong.
    in-out property <bool> verification-failed: false;
    in-out property <int> pades-level: 0;
    // -1 = approval signature; 1..3 = DocMDP certification permission.
    in-out property <int> certification-permission: -1;
    in-out property <string> appearance-path: "";
    in-out property <string> appearance-name: "";
    in-out property <[string]> appearance-options: [];
    private property <int> appearance-return-dialog: 1;
    in-out property <int> identity-kind: 0;
    in-out property <string> token-label: "";
    in-out property <string> token-status: "";
    in-out property <[string]> token-options: [];
    in-out property <[PageItem]> pages: [];
    in-out property <int> scroll-page: 0;
    in-out property <length> pages-scroll-y: 0px;
    in-out property <bool> placement-mode: false;
    in-out property <bool> selection-mode: false;
    private property <bool> selection-active: false;
    private property <float> selection-start-x: 0;
    private property <float> selection-start-y: 0;
    private property <float> selection-current-x: 0;
    private property <float> selection-current-y: 0;
    in-out property <bool> signature-position-set: false;
    // Size of the visible signature as a fraction of the page, so the preview
    // drawn while placing it is the size that ends up in the PDF.
    in-out property <float> signature-box-width: 0.32;
    in-out property <float> signature-box-height: 0.09;
    in-out property <float> signature-default-x: 0.2;
    in-out property <float> signature-default-y: 0.9;
    private property <float> placement-x: 0.5;
    private property <float> placement-y: 0.5;
    private property <int> placement-page: -1;
    // Acrobat asks you to drag a box for the signature area. A plain click still
    // works and drops the default size at that point.
    private property <bool> placement-dragging: false;
    private property <float> placement-start-x: 0;
    private property <float> placement-start-y: 0;
    in-out property <bool> signature-area-set: false;
    in-out property <float> signature-x2: 0;
    in-out property <float> signature-y2: 0;
    in-out property <int> signature-page: 0;
    in-out property <float> signature-x: 0;
    in-out property <float> signature-y: 0;
    private property <bool> compact-header: false;
    // Zoom 100 % means "as wide as the window allows". Everything that measures a
    // page — the list, the scroll maths and the renderer — reads this one value.
    in-out property <length> page-base-width: clamp(root.width - 2 * Space.section, 320px, 1400px);

    callback open-document;
    callback show-signature-center;
    callback close-dialog;
    callback choose-signing;
    callback previous-page;
    callback next-page;
    callback zoom-out;
    callback zoom-in;
    callback fit-width;
    callback search-document(string);
    callback copy-current-page;
    callback copy-selection(int, float, float, float, float);
    callback select-identity;
    callback show-identity-library;
    callback choose-identity(int);
    callback sign-with-identity(string, int, int, string, string, bool);
    callback unlock-document(string);
    callback cancel-unlock;
    callback check-updates;
    callback install-update;
    callback verify-signatures;
    callback select-appearance;
    callback show-appearance-library;
    callback choose-appearance(int);
    callback discover-tokens;
    callback select-token-module;
    callback choose-token(int);
    callback request-page(int);
    callback visible-page(int);
    // Moving a frameless window means asking the compositor to move it; setting
    // a position outright is ignored on Wayland.
    callback start-window-drag;
    changed placement-mode => {
        if (root.placement-mode && root.signature-position-set) {
            // Changing an existing area shows where it is now. A first placement
            // shows nothing until the pointer moves, because there is no default
            // position to preview — that is the point.
            root.placement-page = root.signature-page;
            root.placement-x = root.signature-x;
            root.placement-y = root.signature-y;
        } else if (root.placement-mode) {
            root.placement-page = -1;
        }
    }
    changed scroll-page => {
        root.pages-scroll-y = 0px - root.scroll-page * (root.page-base-width * 1.414 * root.zoom-percent / 100 + Space.xxl);
    }
    changed pages-scroll-y => {
        root.visible-page(max(0, round((0px - root.pages-scroll-y) / (root.page-base-width * 1.414 * root.zoom-percent / 100 + Space.xxl))));
    }

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        KeyBinding { keys: @keys(Control + O); activated => { root.open-document(); } }
        KeyBinding { keys: @keys(Control + F); activated => { root.search-open = true; } }
        KeyBinding { keys: @keys(Control + K); activated => { root.search-open = true; } }
        KeyBinding { keys: @keys(Control + Shift + S); enabled: root.document-open; activated => { root.show-signature-center(); } }
        KeyBinding { keys: @keys(Control + "0"); enabled: root.document-open; activated => { root.fit-width(); } }
        KeyBinding { keys: @keys(Control + C); enabled: root.document-open && !root.search-open; activated => { root.copy-current-page(); } }
        KeyBinding { keys: @keys(Meta + O); activated => { root.open-document(); } }
        KeyBinding { keys: @keys(Meta + F); activated => { root.search-open = true; } }
        KeyBinding { keys: @keys(Meta + K); activated => { root.search-open = true; } }
        KeyBinding { keys: @keys(Meta + Shift + S); enabled: root.document-open; activated => { root.show-signature-center(); } }
        KeyBinding { keys: @keys(Meta + "0"); enabled: root.document-open; activated => { root.fit-width(); } }
        KeyBinding { keys: @keys(Meta + C); enabled: root.document-open && !root.search-open; activated => { root.copy-current-page(); } }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.placement-mode) {
                    root.placement-mode = false;
                    root.active-dialog = 2;
                    root.viewer-status = "Colocación cancelada";
                }
                else if (root.selection-mode) {
                    root.selection-mode = false;
                    root.selection-active = false;
                    root.viewer-status = "Selección cancelada";
                }
                else if (root.active-dialog > 0) { root.close-dialog(); }
                else if (root.search-open) { root.search-open = false; root.search-status = ""; }
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: 0px;
        // Toolbar: file actions on the left, document identity next to them,
        // view and app actions on the right, one primary action at the end.
        Rectangle {
            height: 52px;
            background: Theme.surface;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }

            // Dragging the bar moves the window, the way a title bar does. It is
            // declared before the controls so they stay on top and keep their
            // clicks; only the empty stretch between them starts a drag.
            drag-area := TouchArea {
                mouse-cursor: default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) { root.start-window-drag(); }
                }
                double-clicked => { root.maximized = !root.maximized; }
            }

            HorizontalLayout {
                padding-left: Space.md;
                padding-right: Space.md;
                padding-top: Space.sm;
                padding-bottom: Space.sm;
                spacing: Space.sm;

                ActionButton {
                    label: "Abrir";
                    icon: @image-url("../../data/icons/folder-open.svg");
                    tone: ButtonTone.ghost;
                    clicked => { root.open-document(); }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 1px; height: 20px; background: Theme.border; }
                }

                if !(root.compact-header && root.search-open): VerticalLayout {
                    alignment: center;
                    spacing: 0px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.document-open ? root.document-title : "Nitum PDF";
                        color: Theme.text;
                        font-size: Type.body;
                        font-weight: Type.semibold;
                        overflow: elide;
                    }
                    if root.document-open: Text {
                        text: root.page-count > 0 ? root.page-count + " páginas · en este equipo" : "En este equipo";
                        color: Theme.text-tertiary;
                        font-size: Type.caption;
                        overflow: elide;
                    }
                }

                if root.search-open: HorizontalLayout {
                    spacing: Space.sm;
                    alignment: center;
                    search-input := LineEdit {
                        width: root.compact-header ? 180px : 280px;
                        placeholder-text: "Buscar en el PDF";
                        accessible-label: "Buscar texto en el PDF";
                        accepted(value) => { root.search-document(value); }
                    }
                    if root.search-status != "": Text {
                        text: root.search-status;
                        color: Theme.text-secondary;
                        font-size: Type.small;
                        vertical-alignment: center;
                    }
                }

                if root.document-open: IconAction {
                    icon: root.search-open
                        ? @image-url("../../data/icons/close.svg")
                        : @image-url("../../data/icons/search.svg");
                    hint: root.search-open ? "Cerrar la búsqueda" : "Buscar en el documento";
                    active: root.search-open;
                    clicked => { root.search-open = !root.search-open; root.search-status = ""; }
                }
                IconAction {
                    icon: Theme.dark
                        ? @image-url("../../data/icons/sun.svg")
                        : @image-url("../../data/icons/moon.svg");
                    hint: Theme.dark ? "Cambiar a tema claro" : "Cambiar a tema oscuro";
                    clicked => { Theme.dark = !Theme.dark; }
                }
                IconAction {
                    icon: root.update-available
                        ? @image-url("../../data/icons/download.svg")
                        : @image-url("../../data/icons/shield-check.svg");
                    hint: root.update-available
                        ? "Hay una versión nueva disponible"
                        : "Comprobar si hay actualizaciones";
                    active: root.update-available;
                    clicked => { root.check-updates(); }
                }

                if root.document-open: Rectangle { width: Space.xs; }

                if root.document-open: ActionButton {
                    label: root.compact-header ? "Firmar" : "Firmar este PDF";
                    icon: @image-url("../../data/icons/sign.svg");
                    tone: ButtonTone.primary;
                    clicked => { root.show-signature-center(); }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 1px; height: 20px; background: Theme.border; }
                }

                IconAction {
                    icon: @image-url("../../data/icons/window-minimize.svg");
                    hint: "Minimizar la ventana";
                    clicked => { root.minimized = true; }
                }
                IconAction {
                    icon: root.maximized
                        ? @image-url("../../data/icons/window-restore.svg")
                        : @image-url("../../data/icons/window-maximize.svg");
                    hint: root.maximized ? "Restaurar el tamaño" : "Maximizar la ventana";
                    clicked => { root.maximized = !root.maximized; }
                }
                IconAction {
                    icon: @image-url("../../data/icons/close.svg");
                    hint: "Cerrar Nitum PDF";
                    clicked => { root.close(); }
                }
            }

        }

        Rectangle {
            vertical-stretch: 1; background: Theme.canvas;
            if !root.document-open: VerticalLayout {
                alignment: center;
                spacing: Space.lg;
                padding: Space.section;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 64px; height: 64px;
                        border-radius: Radius.lg;
                        background: Theme.accent-soft;
                        Image {
                            source: @image-url("../../data/icons/document.svg");
                            width: 30px; height: 30px;
                            colorize: Theme.accent;
                        }
                    }
                }
                VerticalLayout {
                    spacing: Space.sm;
                    Text {
                        text: "Abre un PDF para empezar";
                        color: Theme.text;
                        font-size: Type.display;
                        font-weight: Type.bold;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Se lee y se firma en este equipo. El archivo no sale de aquí.";
                        color: Theme.text-secondary;
                        font-size: Type.emphasis;
                        horizontal-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    ActionButton {
                        label: "Abrir un PDF";
                        icon: @image-url("../../data/icons/folder-open.svg");
                        tone: ButtonTone.primary;
                        clicked => { root.open-document(); }
                    }
                }
                Text {
                    text: "Atajo: Ctrl + O";
                    color: Theme.text-tertiary;
                    font-size: Type.small;
                    horizontal-alignment: center;
                }
            }
            if root.document-open: Rectangle {
                VerticalLayout {
                    // Room for the floating reading bar: 44 px tall plus lg above and below.
                    padding-bottom: 44px + 2 * Space.lg;
                pages-view := ListView {
                    viewport-y <=> root.pages-scroll-y;
                    for page[index] in root.pages: Rectangle {
                        height: root.page-base-width * root.zoom-percent / 100 * page.aspect + Space.xxl;
                        init => { root.request-page(index); }
                        Rectangle {
                            x: (parent.width - self.width) / 2; y: 16px;
                            width: root.page-base-width * root.zoom-percent / 100; height: self.width * page.aspect;
                            background: Theme.page; border-radius: Radius.sm;
                            accessible-role: image;
                            accessible-label: "Página " + page.number + " de " + root.page-count;
                            drop-shadow-blur: 24px; drop-shadow-color: Theme.shadow-page; drop-shadow-offset-y: 10px;
                            if page.loaded: Image { source: page.image; image-fit: contain; }
                            if !page.loaded && page.error == "": VerticalLayout {
                                alignment: center; spacing: Space.sm;
                                ProgressIndicator { indeterminate: true; width: 140px; height: 3px; }
                                Text { text: "Página " + page.number; color: Theme.text-secondary; font-size: Type.small; horizontal-alignment: center; }
                            }
                            if page.error != "": Text { text: page.error; color: Theme.danger; font-size: Type.small; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
                            if root.placement-mode: Rectangle {
                                background: transparent;
                                border-width: 2px;
                                border-color: Theme.accent;

                                // While dragging, the box is the rectangle being
                                // drawn; otherwise it is the default size centred
                                // on the pointer. Either way it is the box that
                                // gets written into the PDF.
                                if root.placement-page == index: Rectangle {
                                    property <float> left-fraction: root.placement-dragging
                                        ? min(root.placement-start-x, root.placement-x)
                                        : clamp(root.placement-x - root.signature-box-width / 2,
                                                0, 1 - root.signature-box-width);
                                    property <float> top-fraction: root.placement-dragging
                                        ? min(root.placement-start-y, root.placement-y)
                                        : clamp(root.placement-y - root.signature-box-height / 2,
                                                0, 1 - root.signature-box-height);
                                    x: self.left-fraction * parent.width;
                                    y: self.top-fraction * parent.height;
                                    width: (root.placement-dragging
                                        ? abs(root.placement-x - root.placement-start-x)
                                        : root.signature-box-width) * parent.width;
                                    height: (root.placement-dragging
                                        ? abs(root.placement-y - root.placement-start-y)
                                        : root.signature-box-height) * parent.height;
                                    border-radius: Radius.sm;
                                    border-width: 2px;
                                    border-color: Theme.accent;
                                    background: Theme.accent-soft;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: root.placement-dragging
                                                ? "Suelta para fijar el área"
                                                : "Tu firma irá aquí";
                                            color: Theme.accent;
                                            font-size: Type.small;
                                            font-weight: Type.semibold;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                place := TouchArea {
                                    mouse-cursor: crosshair;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            root.placement-page = index;
                                            root.placement-start-x = place.mouse-x / parent.width;
                                            root.placement-start-y = place.mouse-y / parent.height;
                                            root.placement-x = root.placement-start-x;
                                            root.placement-y = root.placement-start-y;
                                            root.placement-dragging = true;
                                        } else if (event.kind == PointerEventKind.move) {
                                            root.placement-page = index;
                                            root.placement-x = place.mouse-x / parent.width;
                                            root.placement-y = place.mouse-y / parent.height;
                                        } else if (event.kind == PointerEventKind.up
                                                   && root.placement-dragging) {
                                            root.placement-x = place.mouse-x / parent.width;
                                            root.placement-y = place.mouse-y / parent.height;
                                            root.placement-dragging = false;
                                            root.signature-page = index;
                                            root.signature-x = root.placement-start-x;
                                            root.signature-y = root.placement-start-y;
                                            root.signature-x2 = root.placement-x;
                                            root.signature-y2 = root.placement-y;
                                            root.signature-area-set = true;
                                            root.signature-position-set = true;
                                            root.placement-mode = false;
                                            root.placement-page = -1;
                                            root.viewer-status = "Área de la firma fijada en la página " + (index + 1);
                                            root.active-dialog = 2;
                                        }
                                    }
                                }
                            }
                            if root.selection-mode: Rectangle {
                                background: transparent;
                                border-width: 2px;
                                border-color: Theme.accent;
                                if root.selection-active: Rectangle {
                                    x: min(root.selection-start-x, root.selection-current-x) * parent.width;
                                    y: min(root.selection-start-y, root.selection-current-y) * parent.height;
                                    width: abs(root.selection-current-x - root.selection-start-x) * parent.width;
                                    height: abs(root.selection-current-y - root.selection-start-y) * parent.height;
                                    background: Theme.accent-soft;
                                    border-width: 1px;
                                    border-color: Theme.accent;
                                }
                                select-area := TouchArea {
                                    mouse-cursor: crosshair;
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.selection-active = true;
                                            root.selection-start-x = select-area.mouse-x / parent.width;
                                            root.selection-start-y = select-area.mouse-y / parent.height;
                                            root.selection-current-x = root.selection-start-x;
                                            root.selection-current-y = root.selection-start-y;
                                        } else if event.kind == PointerEventKind.move && root.selection-active {
                                            root.selection-current-x = select-area.mouse-x / parent.width;
                                            root.selection-current-y = select-area.mouse-y / parent.height;
                                        } else if event.kind == PointerEventKind.up && root.selection-active {
                                            root.selection-current-x = select-area.mouse-x / parent.width;
                                            root.selection-current-y = select-area.mouse-y / parent.height;
                                            root.copy-selection(index, root.selection-start-x, root.selection-start-y, root.selection-current-x, root.selection-current-y);
                                            root.selection-active = false;
                                            root.selection-mode = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
                if root.document-loading: VerticalLayout {
                    alignment: center; spacing: Space.md;
                    ProgressIndicator { indeterminate: true; width: 160px; height: 3px; }
                    Text { text: "Preparando documento…"; color: Theme.text-secondary; font-size: Type.body; horizontal-alignment: center; }
                }
                if root.document-error != "": VerticalLayout {
                    alignment: center; spacing: Space.md; padding: Space.section;
                    Text {
                        text: "No pudimos mostrar este PDF";
                        color: Theme.text;
                        font-size: Type.title;
                        font-weight: Type.bold;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.document-error;
                        color: Theme.text-secondary;
                        font-size: Type.body;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        ActionButton {
                            label: "Elegir otro PDF";
                            icon: @image-url("../../data/icons/folder-open.svg");
                            tone: ButtonTone.primary;
                            clicked => { root.open-document(); }
                        }
                    }
                }
            }
            if root.viewer-status != "" && root.active-dialog == 0 && !root.placement-mode && !root.selection-mode: Rectangle {
                width: toast.preferred-width;
                height: 36px;
                x: (parent.width - self.width) / 2;
                y: Space.lg;
                border-radius: Radius.md;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 16px;
                drop-shadow-color: Theme.shadow-raised;
                drop-shadow-offset-y: 4px;
                toast := HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.md;
                    Text {
                        text: root.viewer-status;
                        color: Theme.text;
                        font-size: Type.small;
                        vertical-alignment: center;
                    }
                }
            }
            // Reading controls float over the document, Figma-style, and the page
            // list reserves room for them so they never cover a line of text.
            if root.document-open && !root.placement-mode && !root.selection-mode: Rectangle {
                width: bar.preferred-width;
                height: 44px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Space.lg;
                border-radius: Radius.lg;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 20px;
                drop-shadow-color: Theme.shadow-floating;
                drop-shadow-offset-y: 6px;
                bar := HorizontalLayout {
                    padding-left: Space.sm;
                    padding-right: Space.sm;
                    padding-top: Space.xs;
                    padding-bottom: Space.xs;
                    spacing: Space.xs;

                    IconAction {
                        icon: @image-url("../../data/icons/chevron-left.svg");
                        hint: "Página anterior";
                        enabled: root.current-page > 1;
                        clicked => { root.previous-page(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.current-page + " / " + root.page-count;
                            color: Theme.text;
                            font-size: Type.body;
                            font-weight: Type.medium;
                            horizontal-alignment: center;
                            min-width: 56px;
                        }
                    }
                    IconAction {
                        icon: @image-url("../../data/icons/chevron-right.svg");
                        hint: "Página siguiente";
                        enabled: root.current-page < root.page-count;
                        clicked => { root.next-page(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 1px; height: 20px; background: Theme.border; }
                    }

                    IconAction {
                        icon: @image-url("../../data/icons/zoom-out.svg");
                        hint: "Alejar";
                        clicked => { root.zoom-out(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.zoom-percent + "%";
                            color: Theme.text;
                            font-size: Type.body;
                            font-weight: Type.medium;
                            horizontal-alignment: center;
                            min-width: 44px;
                        }
                    }
                    IconAction {
                        icon: @image-url("../../data/icons/zoom-in.svg");
                        hint: "Acercar";
                        clicked => { root.zoom-in(); }
                    }
                    IconAction {
                        icon: @image-url("../../data/icons/fit-width.svg");
                        hint: "Ajustar al ancho de la ventana";
                        clicked => { root.fit-width(); }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 1px; height: 20px; background: Theme.border; }
                    }

                    if root.compact-header: IconAction {
                        icon: @image-url("../../data/icons/select-text.svg");
                        hint: "Seleccionar una zona de texto";
                        clicked => {
                            root.selection-mode = true;
                            root.viewer-status = "Arrastra sobre el texto que quieres copiar · Esc para cancelar";
                        }
                    }
                    if root.compact-header: IconAction {
                        icon: @image-url("../../data/icons/copy.svg");
                        hint: "Copiar el texto de la página";
                        clicked => { root.copy-current-page(); }
                    }
                    if !root.compact-header: ActionButton {
                        label: "Seleccionar";
                        tone: ButtonTone.ghost;
                        clicked => {
                            root.selection-mode = true;
                            root.viewer-status = "Arrastra sobre el texto que quieres copiar · Esc para cancelar";
                        }
                    }
                    if !root.compact-header: ActionButton {
                        label: "Copiar página";
                        icon: @image-url("../../data/icons/copy.svg");
                        tone: ButtonTone.ghost;
                        clicked => { root.copy-current-page(); }
                    }
                }
            }
            if root.document-open && (root.selection-mode || root.placement-mode): Rectangle {
                width: mode-bar.preferred-width;
                height: 44px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - Space.lg;
                border-radius: Radius.lg;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.accent;
                drop-shadow-blur: 20px;
                drop-shadow-color: Theme.shadow-floating;
                drop-shadow-offset-y: 6px;
                mode-bar := HorizontalLayout {
                    padding-left: Space.md;
                    padding-right: Space.sm;
                    padding-top: Space.xs;
                    padding-bottom: Space.xs;
                    spacing: Space.md;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.placement-mode
                                ? @image-url("../../data/icons/sign.svg")
                                : @image-url("../../data/icons/copy.svg");
                            width: 18px;
                            height: 18px;
                            colorize: Theme.accent;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.placement-mode
                                ? "Arrastra para dibujar el área de la firma, o haz clic para el tamaño estándar"
                                : "Arrastra sobre el texto que quieres copiar";
                            color: Theme.text;
                            font-size: Type.body;
                            font-weight: Type.medium;
                        }
                    }
                    ActionButton {
                        label: "Cancelar";
                        tone: ButtonTone.secondary;
                        clicked => {
                            if (root.placement-mode) {
                                root.placement-mode = false;
                                root.active-dialog = 2;
                                root.viewer-status = "Colocación cancelada";
                            } else {
                                root.selection-mode = false;
                                root.selection-active = false;
                                root.viewer-status = "Selección cancelada";
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // Every dialog is sized by its own content and capped by the window, and
    // every one of them carries at most one primary action, in the footer.
    if root.active-dialog > 0: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        if root.active-dialog == 1: Dialog {
            title: "¿Qué necesitas hacer?";
            subtitle: "Antes de cambiar el PDF te explicamos qué va a ocurrir.";
            width: min(parent.width - 2 * Space.xl, 560px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            closed => { root.close-dialog(); }
            VerticalLayout {
                spacing: Space.xs;
                ChoiceRow {
                    title: "Firmar con mi identidad";
                    detail: "Archivo .p12 o .pfx, tarjeta o token criptográfico";
                    icon: @image-url("../../data/icons/sign.svg");
                    action: "Continuar";
                    chosen => { root.choose-signing(); }
                }
                ChoiceRow {
                    title: "Comprobar las firmas del PDF";
                    detail: "Integridad, titular y confianza del certificado";
                    icon: @image-url("../../data/icons/shield-check.svg");
                    action: "Comprobar";
                    chosen => { root.verify-signatures(); }
                }
                ChoiceRow {
                    title: "Mis firmas visuales";
                    detail: "Guarda y reutiliza tu rúbrica junto a los datos verificables";
                    icon: @image-url("../../data/icons/document.svg");
                    action: "Abrir";
                    chosen => { root.appearance-return-dialog = 1; root.show-appearance-library(); }
                }
                ChoiceRow {
                    title: "Conectar tarjeta o DNI";
                    detail: "OpenSC, p11-kit y dispositivos PKCS#11";
                    icon: @image-url("../../data/icons/identity.svg");
                    action: "Buscar";
                    chosen => { root.discover-tokens(); }
                }
            }
        }

        if root.active-dialog == 2: Dialog {
            title: "Firmar el documento";
            subtitle: "Se creará un PDF nuevo. El original no se modifica.";
            show-back: true;
            width: min(parent.width - 2 * Space.xl, 620px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: root.signing-busy
                ? "Firmando…"
                : (visible-input.checked && !root.signature-position-set)
                    ? "Dibuja primero el área"
                    : "Firmar y guardar";
            primary-icon: @image-url("../../data/icons/sign.svg");
            primary-enabled: (root.identity-path != "" || root.identity-kind == 1)
                && !root.signing-busy
                && (!visible-input.checked || root.signature-position-set);
            back => { root.active-dialog = 1; }
            closed => { root.placement-mode = false; root.close-dialog(); }
            secondary-activated => { root.placement-mode = false; root.close-dialog(); }
            primary-activated => {
                root.sign-with-identity(secret-input.text, root.pades-level, root.certification-permission, reason-input.text, location-input.text, visible-input.checked);
                secret-input.text = "";
            }

            Field {
                label: "Identidad digital";
                Rectangle {
                    height: 64px;
                    border-radius: Radius.md;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: Space.md;
                        padding-right: Space.sm;
                        spacing: Space.md;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../../data/icons/identity.svg");
                                width: 20px; height: 20px;
                                colorize: root.identity-path == "" && root.identity-kind != 1 ? Theme.text-tertiary : Theme.accent;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: Space.xs;
                            horizontal-stretch: 1;
                            Text {
                                text: root.identity-kind == 1
                                    ? root.token-label
                                    : root.identity-name == "" ? "Sin identidad elegida" : root.identity-name;
                                color: Theme.text;
                                font-size: Type.body;
                                font-weight: Type.semibold;
                                overflow: elide;
                            }
                            Text {
                                text: root.identity-kind == 1
                                    ? "La clave privada nunca sale de la tarjeta"
                                    : root.identity-name == ""
                                        ? "Elige un archivo .p12 o .pfx, o una tarjeta"
                                        : "La clave privada permanece en este equipo";
                                color: Theme.text-secondary;
                                font-size: Type.small;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Space.xs;
                                ActionButton {
                                    label: "Archivo";
                                    tone: ButtonTone.secondary;
                                    clicked => { root.show-identity-library(); }
                                }
                                ActionButton {
                                    label: "Tarjeta";
                                    tone: ButtonTone.secondary;
                                    clicked => { root.discover-tokens(); }
                                }
                            }
                        }
                    }
                }
            }

            Field {
                label: root.identity-kind == 1 ? "PIN de la tarjeta" : "Contraseña de la identidad";
                help: "Se usa una sola vez para firmar y no se guarda en ningún sitio.";
                secret-input := LineEdit {
                    enabled: (root.identity-path != "" || root.identity-kind == 1) && !root.signing-busy;
                    input-type: password;
                    placeholder-text: root.identity-kind == 1 ? "PIN" : "Contraseña";
                    accessible-label: root.identity-kind == 1 ? "PIN de la tarjeta" : "Contraseña de la identidad digital";
                    accepted(value) => {
                        if (root.identity-path != "" || root.identity-kind == 1) && !root.signing-busy {
                            root.sign-with-identity(value, root.pades-level, root.certification-permission, reason-input.text, location-input.text, visible-input.checked);
                            self.text = "";
                        }
                    }
                }
            }

            Field {
                label: "Tipo de firma";
                VerticalLayout {
                    spacing: Space.xs;
                    ChoiceRow {
                        title: "Firmar para aprobar";
                        detail: "Otras personas podrán firmar después de ti";
                        option: true;
                        is-selected: root.certification-permission == -1;
                        chosen => { root.certification-permission = -1; }
                    }
                    ChoiceRow {
                        title: "Certificar el documento";
                        detail: "Debe ser la primera firma y fija qué cambios se permiten";
                        option: true;
                        is-selected: root.certification-permission != -1;
                        chosen => { root.certification-permission = 2; }
                    }
                }
            }

            if root.certification-permission != -1: Field {
                label: "Cambios que seguirán permitidos";
                VerticalLayout {
                    spacing: Space.xs;
                    ChoiceRow {
                        title: "Ninguno";
                        option: true;
                        detail: "Cualquier cambio posterior invalida la certificación";
                        is-selected: root.certification-permission == 1;
                        chosen => { root.certification-permission = 1; }
                    }
                    ChoiceRow {
                        title: "Rellenar formularios";
                        option: true;
                        detail: "Se permite completar campos y firmar";
                        is-selected: root.certification-permission == 2;
                        chosen => { root.certification-permission = 2; }
                    }
                    ChoiceRow {
                        title: "Formularios y anotaciones";
                        option: true;
                        detail: "Se permite además comentar y anotar";
                        is-selected: root.certification-permission == 3;
                        chosen => { root.certification-permission = 3; }
                    }
                }
            }

            Field {
                label: "Firma visible";
                visible-input := Toggle {
                    label: "Mostrar la firma sobre la página";
                    help: "La validez la aporta el certificado; lo visible sólo ayuda a reconocerla.";
                    checked: true;
                }
            }

            if visible-input.checked: Field {
                label: "Dónde va la firma";
                VerticalLayout {
                    spacing: Space.xs;
                    ChoiceRow {
                        title: root.signature-area-set
                            ? "Área dibujada en la página " + (root.signature-page + 1)
                            : root.signature-position-set
                                ? "En la página " + (root.signature-page + 1) + ", donde la colocaste"
                                : "Todavía no has elegido dónde";
                        detail: root.signature-position-set
                            ? "Pulsa para dibujar otra área sobre el documento"
                            : "Pulsa y arrastra sobre el documento para dibujar el área de la firma";
                        icon: @image-url("../../data/icons/sign.svg");
                        action: root.signature-position-set ? "Cambiar" : "Elegir";
                        chosen => {
                            root.placement-mode = true;
                            root.active-dialog = 0;
                            root.viewer-status = "";
                        }
                    }
                    ChoiceRow {
                        title: root.appearance-name == ""
                            ? "Apariencia: datos verificables"
                            : "Apariencia: " + root.appearance-name;
                        detail: "Nombre, fecha y motivo, con tu imagen si eliges una";
                        icon: @image-url("../../data/icons/document.svg");
                        action: "Cambiar";
                        chosen => { root.appearance-return-dialog = 2; root.show-appearance-library(); }
                    }
                }
            }

            Disclosure {
                label: "Opciones avanzadas";
                Field {
                    label: "Validez a largo plazo";
                    VerticalLayout {
                        spacing: Space.xs;
                        ChoiceRow {
                            title: "Básica";
                            option: true;
                            detail: "Firma simple, sin sello de tiempo (PAdES B-B)";
                            is-selected: root.pades-level == 0;
                            chosen => { root.pades-level = 0; }
                        }
                        ChoiceRow {
                            title: "Con sello de tiempo";
                            option: true;
                            detail: "Prueba cuándo se firmó (PAdES B-T)";
                            is-selected: root.pades-level == 1;
                            chosen => { root.pades-level = 1; }
                        }
                        ChoiceRow {
                            title: "Validación duradera";
                            option: true;
                            detail: "Incluye la prueba de validez del certificado (PAdES B-LT)";
                            is-selected: root.pades-level == 2;
                            chosen => { root.pades-level = 2; }
                        }
                        ChoiceRow {
                            title: "Archivo";
                            option: true;
                            detail: "Pensada para conservar el documento años (PAdES B-LTA)";
                            is-selected: root.pades-level == 3;
                            chosen => { root.pades-level = 3; }
                        }
                    }
                }
                Field {
                    label: "Motivo";
                    reason-input := LineEdit {
                        placeholder-text: "Opcional";
                        accessible-label: "Motivo de la firma, opcional";
                    }
                }
                Field {
                    label: "Ubicación";
                    location-input := LineEdit {
                        placeholder-text: "Opcional";
                        accessible-label: "Ubicación de la firma, opcional";
                    }
                }
            }

            if root.signing-status != "": Note {
                message: root.signing-status;
                tone: root.signing-success ? StatusTone.positive : StatusTone.negative;
                icon: root.signing-success
                    ? @image-url("../../data/icons/shield-check.svg")
                    : @image-url("../../data/icons/alert.svg");
            }
        }

        if root.active-dialog == 3: Dialog {
            title: "Este PDF está protegido";
            subtitle: "Se usa una sola vez y nunca se guarda.";
            width: min(parent.width - 2 * Space.xl, 460px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: root.unlock-busy ? "Abriendo…" : "Abrir PDF";
            primary-enabled: !root.unlock-busy;
            secondary-label: "Cancelar";
            closed => { root.cancel-unlock(); }
            secondary-activated => { root.cancel-unlock(); }
            primary-activated => {
                if unlock-input.text != "" {
                    root.unlock-document(unlock-input.text);
                    unlock-input.text = "";
                }
            }
            Field {
                label: "Contraseña del PDF";
                unlock-input := LineEdit {
                    enabled: !root.unlock-busy;
                    input-type: password;
                    placeholder-text: "Contraseña";
                    accessible-label: "Contraseña para abrir el PDF";
                    accepted(value) => {
                        if !root.unlock-busy && value != "" {
                            root.unlock-document(value);
                            self.text = "";
                        }
                    }
                }
            }
            if root.unlock-status != "": Note {
                message: root.unlock-status;
                tone: StatusTone.negative;
                icon: @image-url("../../data/icons/alert.svg");
            }
        }

        if root.active-dialog == 4: Dialog {
            title: root.update-checking
                ? "Buscando actualizaciones…"
                : root.update-available
                    ? "Nitum PDF " + root.update-version + " está disponible"
                    : "Nitum PDF está actualizado";
            subtitle: root.update-available
                ? "Comprobamos su SHA-256 antes de instalarlo."
                : "Versión instalada: " + root.current-version + ".";
            width: min(parent.width - 2 * Space.xl, 480px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: root.update-available
                ? (root.update-busy ? "Actualizando…" : "Actualizar y reiniciar")
                : "";
            primary-enabled: !root.update-busy && !root.update-checking;
            secondary-label: root.update-available ? "Ahora no" : "Cerrar";
            closed => { root.close-dialog(); }
            secondary-activated => { root.close-dialog(); }
            primary-activated => { root.install-update(); }
            if root.update-checking: ProgressIndicator {
                indeterminate: true;
                height: 3px;
            }
            if root.update-status != "": Note {
                message: root.update-status;
                tone: root.update-available ? StatusTone.caution : StatusTone.positive;
                icon: root.update-available
                    ? @image-url("../../data/icons/download.svg")
                    : @image-url("../../data/icons/shield-check.svg");
            }
            if root.update-available && !root.update-busy: Text {
                text: "Al terminar, Nitum se reiniciará y volverá a abrir este documento.";
                color: Theme.text-secondary;
                font-size: Type.small;
                wrap: word-wrap;
            }
        }

        if root.active-dialog == 5: Dialog {
            title: "Comprobar las firmas";
            subtitle: "Revisión local: integridad, cobertura y confianza por separado.";
            show-back: true;
            width: min(parent.width - 2 * Space.xl, 560px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            secondary-label: "Cerrar";
            back => { root.active-dialog = 1; }
            closed => { root.close-dialog(); }
            secondary-activated => { root.close-dialog(); }

            if root.verification-busy: ProgressIndicator {
                indeterminate: true;
                height: 3px;
            }

            // Each check states its own verdict. A document can be intact and
            // still come from a certificate nobody has vouched for, and saying
            // so in one green sentence would hide exactly that.
            if root.verification-checks.length > 0: VerticalLayout {
                spacing: Space.xs;
                for check[index] in root.verification-checks: Rectangle {
                    height: row.preferred-height;
                    border-radius: Radius.md;
                    background: check.tone == 1 ? Theme.success-soft
                        : check.tone == 2 ? Theme.warning-soft
                        : check.tone == 3 ? Theme.danger-soft
                        : transparent;
                    border-width: check.tone == 0 ? 1px : 0px;
                    border-color: Theme.border;
                    accessible-role: text;
                    accessible-label: check.label + ": " + check.detail;
                    row := HorizontalLayout {
                        padding: Space.md;
                        spacing: Space.md;
                        Rectangle {
                            width: 20px;
                            Image {
                                source: check.tone == 1
                                    ? @image-url("../../data/icons/shield-check.svg")
                                    : check.tone == 2
                                        ? @image-url("../../data/icons/alert.svg")
                                        : check.tone == 3
                                            ? @image-url("../../data/icons/close.svg")
                                            : @image-url("../../data/icons/identity.svg");
                                width: 18px;
                                height: 18px;
                                colorize: check.tone == 1 ? Theme.success
                                    : check.tone == 2 ? Theme.warning
                                    : check.tone == 3 ? Theme.danger
                                    : Theme.text-secondary;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text {
                                text: check.label;
                                color: Theme.text;
                                font-size: Type.body;
                                font-weight: Type.semibold;
                            }
                            Text {
                                text: check.detail;
                                color: Theme.text-secondary;
                                font-size: Type.small;
                                min-height: 17px;
                                vertical-stretch: 0;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            if root.verification-checks.length == 0 && root.verification-status != "": Note {
                message: root.verification-status;
                tone: root.verification-failed ? StatusTone.negative : StatusTone.neutral;
                icon: root.verification-failed
                    ? @image-url("../../data/icons/alert.svg")
                    : @image-url("../../data/icons/document.svg");
            }
        }

        if root.active-dialog == 6: Dialog {
            title: "Tarjetas y tokens";
            subtitle: root.token-status;
            show-back: true;
            width: min(parent.width - 2 * Space.xl, 520px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: "Elegir módulo PKCS#11";
            primary-tone: ButtonTone.secondary;
            back => { root.active-dialog = 1; }
            closed => { root.close-dialog(); }
            primary-activated => { root.select-token-module(); }
            VerticalLayout {
                spacing: Space.xs;
                for option[index] in root.token-options: ChoiceRow {
                    title: option;
                    icon: @image-url("../../data/icons/identity.svg");
                    action: "Usar";
                    chosen => { root.choose-token(index); }
                }
            }
        }

        if root.active-dialog == 7: Dialog {
            title: "Firmas visuales guardadas";
            subtitle: "La validez siempre proviene de tu certificado, no de la imagen.";
            show-back: true;
            width: min(parent.width - 2 * Space.xl, 520px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: "Añadir imagen";
            back => { root.active-dialog = root.appearance-return-dialog; }
            closed => { root.close-dialog(); }
            secondary-activated => { root.close-dialog(); }
            primary-activated => { root.select-appearance(); }
            if root.appearance-options.length == 0: Text {
                text: "Todavía no tienes firmas visuales guardadas.";
                color: Theme.text-secondary;
                font-size: Type.body;
            }
            VerticalLayout {
                spacing: Space.xs;
                for option[index] in root.appearance-options: ChoiceRow {
                    title: option;
                    icon: @image-url("../../data/icons/document.svg");
                    action: "Usar";
                    chosen => { root.choose-appearance(index); }
                }
            }
        }

        if root.active-dialog == 8: Dialog {
            title: "Identidades digitales";
            subtitle: "La contraseña se pide después y nunca se almacena.";
            show-back: true;
            width: min(parent.width - 2 * Space.xl, 520px);
            available-height: parent.height - 2 * Space.xl;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            primary-label: "Importar .p12 o .pfx";
            back => { root.active-dialog = 2; }
            closed => { root.close-dialog(); }
            secondary-activated => { root.close-dialog(); }
            primary-activated => { root.select-identity(); }
            if root.identity-options.length == 0: Text {
                text: "Todavía no tienes identidades guardadas.";
                color: Theme.text-secondary;
                font-size: Type.body;
            }
            VerticalLayout {
                spacing: Space.xs;
                for option[index] in root.identity-options: ChoiceRow {
                    title: option;
                    icon: @image-url("../../data/icons/identity.svg");
                    action: "Usar";
                    chosen => { root.choose-identity(index); }
                }
            }
        }
    }

}
